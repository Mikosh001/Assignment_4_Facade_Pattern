@startuml
!pragma layout smetana
skinparam dpi 180
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classFontSize 16
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true
skinparam nodesep 28
skinparam ranksep 35
top to bottom direction

class Main <<Client>> {
  {static} +main(String[]): void
}

class OrderFacade <<Facade>> {
  -inventory: InventoryService
  -payment: PaymentProcessor
  -shipping: ShippingService
  -notifications: NotificationService
  +placeOrder(Map<String, Integer>, String): String
}

class InventoryService <<Subsystem>> {
  -stock: Map<String, Integer>
  -prices: Map<String, Integer>
  +totalPrice(Map<String, Integer>): int
  +reserve(Map<String, Integer>): void
  +release(Map<String, Integer>): void
  +available(String): int
}

class PaymentProcessor <<Subsystem>> {
  -balances: Map<String, Integer>
  +charge(String, int): void
  +refund(String, int): void
  +balanceOf(String): int
}

class ShippingService <<Subsystem>> {
  -addresses: Map<String, String>
  -shipments: Map<String, String>
  -nextOrderNumber: int
  +ship(Map<String, Integer>, String): String
  +cancel(String): void
}

class NotificationService <<Subsystem>> {
  -confirmations: Map<String, String>
  +sendConfirmation(String, String, int): String
}

Main ..> OrderFacade : creates, placeOrder()
OrderFacade *-- InventoryService
OrderFacade *-- PaymentProcessor
OrderFacade *-- ShippingService
OrderFacade *-- NotificationService
InventoryService -[hidden]right- PaymentProcessor
InventoryService -[hidden]down- ShippingService
PaymentProcessor -[hidden]down- NotificationService
@enduml
